{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/ssr.ts": {
      "includeFiles": ".ssr/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/ssr?p=home" },
    { "source": "/mentions-legales", "destination": "/api/ssr?p=mentions" },
    { "source": "/confidentialite", "destination": "/api/ssr?p=confidentialite" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/api/ssr?p=raw" }
  ]
}
